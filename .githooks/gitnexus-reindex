#!/bin/sh

project_root=$(git rev-parse --show-toplevel 2>/dev/null)
[ -n "$project_root" ] || exit 0
cd "$project_root" || exit 0

if [ -f .gitnexus/run.cjs ]; then
    exec /usr/bin/env node .gitnexus/run.cjs analyze --index-only --name NotchApp
fi

if command -v gitnexus >/dev/null 2>&1; then
    exec gitnexus analyze --index-only --name NotchApp
fi

echo "GitNexus runner is unavailable; run 'gitnexus analyze --index-only --name NotchApp' once."
exit 0
